[Unit]
Description=EDGE-AURA-MFP orchestrator bridge (forwards SensorPackets to PINN-AURA-MFP, handles commands)
Documentation=https://github.com/THMSCMPG/EDGE-AURA-MFP
Requires=aura-edge-daemon.service
After=aura-edge-daemon.service network.target

[Service]
Type=simple
User=aura-edge
Group=aura-edge

WorkingDirectory=/opt/aura-edge
EnvironmentFile=-/etc/aura-edge/bridge.env
Environment=PYTHONUNBUFFERED=1
# The daemon emits one JSON packet per line on its stdout; systemd does not
# plumb that directly to our stdin, so the recommended deployment is to run
# `journalctl -f -u aura-edge-daemon.service -o cat | python -m pi.orchestrator_bridge`
# from a tiny wrapper script. For the default (subprocess_pipe) mode the
# bridge itself spawns the PINN orchestrator; it just needs SensorPacket
# JSONL on its stdin.
ExecStart=/opt/aura-edge/bin/run-bridge
StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/aura-edge/logs /var/log/aura-edge
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
